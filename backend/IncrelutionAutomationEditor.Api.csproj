<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>41b0bdd1-d91d-4ba5-8948-401846ca284d</UserSecretsId>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.5" />

    <!-- Pin transitive dependencies to patched versions to clear NU1903 advisories. -->
    <!-- CVE-2026-49451: Microsoft.OpenApi <= 2.7.4 vulnerable (stack overflow parsing
         untrusted OpenAPI docs); fixed in 2.7.5. We never parse untrusted docs and only
         map the OpenAPI endpoint in Development, so this is warning-clearing only. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <!-- CVE-2025-6965: SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11 bundles a vulnerable SQLite;
         2.1.13 bundles the patched SQLite. Reachable only via attacker-controlled SQL,
         which EF Core parameterization prevents. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GameData\jobs.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GameData\constructions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GameData\explorations.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GameData\skills.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GameData\thresholds.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
